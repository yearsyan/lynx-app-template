<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Package visibility for canOpenURL: on Android 11+ queryIntentActivities
      only sees apps matching a <queries> filter. A VIEW intent without a
      data filter matches every VIEW handler, so arbitrary schemes resolve
      out of the box; hosts that only need specific schemes can narrow this
      to <data android:scheme="…"/> entries.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
        </intent>
    </queries>

</manifest>
