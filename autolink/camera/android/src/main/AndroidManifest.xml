<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Keep installation possible on devices without a camera. Calls report unavailable. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application>
        <activity
            android:name=".CameraCaptureActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/LynxCameraProxyTheme" />

        <provider
            android:name=".LynxCameraFileProvider"
            android:authorities="${applicationId}.lynx.camera.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/lynx_camera_file_paths" />
        </provider>
    </application>
</manifest>
