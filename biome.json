{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["bundle/main/src/App.tsx"],
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off"
          }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "package.json",
      "tsconfig.*.json",
      "scripts/**/*.mjs",
      "contracts/**",
      "create-lynx-app/package.json",
      "create-lynx-app/bin/**",
      "create-lynx-app/src/**",
      "create-lynx-app/test/**",
      "create-lynx-app-alias/package.json",
      "create-lynx-app-alias/bin/**",
      "test/**",
      "autolink/**",
      "!autolink/*/android/build",
      "!autolink/*/harmony/build",
      "!autolink/*/harmony/oh_modules",
      "!autolink/*/harmony/BuildProfile.ets",
      "!autolink/*/harmony/oh-package-lock.json5",
      "bundle/**",
      "lib/**",
      "!app",
      "!bundle/**/dist",
      "!bundle/artifacts",
      "!lib/**/dist",
      "!create-lynx-app/template",
      "!**/node_modules"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "cssModules": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
