  "defaultBundle": "main",
  "routes": [
    { "path": "/", "bundle": "main" },
    {
      "path": "/networkinfo",
      "bundle": "main",
      "params": { "page": "networkinfo" }
    },
    { "path": "/toast", "bundle": "main", "params": { "page": "toast" } }
  ]
}
