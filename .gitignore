app/androidApp/**/*.keystore

# iOS / Xcode / CocoaPods
app/iosApp/Pods/
app/iosApp/build/
app/iosApp/DerivedData/
app/iosApp/.build/
# Lynx Autolink registry generated by cocoapods-lynx-library at pod install
app/iosApp/generated/
# Gradle outputs of the autolinked Android library projects
autolink/*/android/build/
autolink/*/android/.gradle/
autolink/*/android/.cxx/
# HarmonyOS dependencies pulled by autolinked packages
autolink/*/oh_modules/
app/iosApp/*.xcworkspace/
app/iosApp/**/xcuserdata/
app/iosApp/**/*.xcuserstate
app/iosApp/**/*.xccheckout
app/iosApp/**/*.xcscmblueprint
app/iosApp/**/*.ipa
app/iosApp/**/*.dSYM/
