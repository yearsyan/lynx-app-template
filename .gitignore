# Generated Lynx bundles and release manifests
/bundle/*/dist/
/bundle/artifacts/
/app/androidApp/app/src/main/assets/lynxbundle/
/app/iosApp/lynxbundle/
/app/harmonyApp/entry/src/main/resources/rawfile/lynxbundle/

# Legacy generated locations retained here so old worktrees stay clean.
/app/androidApp/app/src/main/assets/*.lynx.bundle
/app/androidApp/app/src/main/assets/lynx-bundles.json
/app/iosApp/*.lynx.bundle
/app/iosApp/lynx-bundles.json
/app/harmonyApp/entry/src/main/resources/rawfile/*.lynx.bundle
/app/harmonyApp/entry/src/main/resources/rawfile/lynx-bundles.json

# Generated workspace package output
lib/*/dist/

# Android / Gradle
app/androidApp/.gradle/
app/androidApp/.kotlin/
app/androidApp/**/build/
app/androidApp/**/.externalNativeBuild/
